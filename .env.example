# Use PostgreSQL URLs from your managed database provider (for example, Neon).
# POSTGRES_PRISMA_URL should be the pooled/runtime connection string.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# DATABASE_URL_UNPOOLED is the direct connection used by Prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
